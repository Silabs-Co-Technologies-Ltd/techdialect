# Local development: SQLite under instance/ is allowed.
# For Vercel use a remote hosted SQLite-compatible Turso database.
# Configure these as Vercel environment secrets, not in source control.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Choose a strong random signing secret.
SECRET_KEY=
# Optional external AI translation integration.
HF_TOKEN=
DAILY_GOAL=20
# Optional: comma-separated public domains and Vercel preview domain(s).
TRUSTED_HOSTS=
# For local http:// development; Vercel automatically forces secure cookies.
COOKIE_SECURE=0
# Optional one-time admin bootstrap. Remove from environment after creation.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
